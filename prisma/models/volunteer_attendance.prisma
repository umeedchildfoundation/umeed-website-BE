model volunteer_attendance {
  id           String    @id @default(uuid())
  session_id   String
  volunteer_id String
  status       AttendanceStatus @default(absent)
  remark       String?
  marked_at    DateTime? @default(now())
  marked_by    String?

  session      sessions   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  volunteer    volunteers @relation(fields: [volunteer_id], references: [id], onDelete: Cascade)
}
