model media {
  id          String    @id @default(uuid())
  event_id    String?
  url         String
  type        MediaType @default(image)
  caption     String?
  filename    String?
  mimetype    String?
  size        Int?
  uploaded_by String?
  created_at  DateTime? @default(now())

  event       events?   @relation(fields: [event_id], references: [id], onDelete: SetNull)
}
