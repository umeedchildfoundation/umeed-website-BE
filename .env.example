# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development                    # development | production | test

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/umeed_db

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080       # URL of the frontend app (used for CORS)

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-secret-key-change-me   # Must be changed in production
JWT_EXPIRES_IN=7d                             # e.g. 1h, 7d, 30d

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
