{
    "name": "umeed-backend",
    "version": "1.0.0",
    "description": "Production backend for UMEED Children Foundation",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc",
        "start": "node dist/server.js",
        "predev": "npm run prisma:generate",
        "prisma:migrate": "npx prisma migrate dev",
        "prisma:generate": "npx prisma generate",
        "seed": "node --experimental-strip-types prisma/seed.ts",
        "seed:reset": "SEED_RESET=true node --experimental-strip-types prisma/seed.ts",
        "script:parshwa-application": "node --experimental-strip-types scripts/reset-parshwa-application.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1000.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcryptjs": "^2.4.3",
        "chalk": "^5.6.2",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.18.2",
        "joi": "^18.0.2",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.19.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.16",
        "@types/pg": "^8.16.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^9.0.8",
        "nodemon": "^3.1.14",
        "prisma": "^7.9.1",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3"
    },
    "allowScripts": {
        "@prisma/engines@7.9.1": true,
        "prisma@7.9.1": true,
        "@scarf/scarf@1.4.0": true,
        "esbuild@0.27.2": true,
        "fsevents@2.3.3": true
    }
}
