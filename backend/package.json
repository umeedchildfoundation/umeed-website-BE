{
    "name": "umeed-backend",
    "version": "1.0.0",
    "description": "Production backend for UMEED Children Foundation",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "prisma:sync": "tsx sync-prisma.ts",
        "prisma:migrate": "npm run prisma:sync && npx prisma migrate dev",
        "prisma:generate": "npm run prisma:sync && npx prisma generate",
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1000.0",
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^6.16.0",
        "bcryptjs": "^2.4.3",
        "chalk": "^5.6.2",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.18.2",
        "joi": "^18.0.2",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.19.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.16",
        "@types/pg": "^8.16.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^9.0.8",
        "prisma": "^6.16.0",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3"
    }
}
