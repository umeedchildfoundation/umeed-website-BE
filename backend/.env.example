# ============================================
# UMEED Backend Environment Configuration
# ============================================
# 
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!
#

# ============== SERVER ==============

# Server port
PORT=3001

# Environment: development or production
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080


# ============== JWT ==============

# Secret key for signing JWT tokens
# ⚠️ CHANGE THIS IN PRODUCTION! Use a long random string
JWT_SECRET=umeed-super-secret-jwt-key-change-in-production

# JWT token expiration time
JWT_EXPIRES_IN=7d


# ============== ADMIN ==============

# Secret key for create-super-admin endpoint (x-admin-secret-key header). Set in production.
# ADMIN_SECRET_KEY=your-secure-random-string


# ============== DATABASE ==============

# Path to SQLite database file
DB_PATH=./data/umeed.db

# Backup path (optional)
# DB_BACKUP_PATH=./data/umeed.db.backup


# ============== FILE UPLOADS ==============

# Directory to store uploaded files
UPLOAD_DIR=./uploads

# Maximum file size (in bytes)
# MAX_FILE_SIZE=10485760


# ============== LOGGING ==============

# Log level: debug, info, warn, error
# LOG_LEVEL=info


# ============== EMAIL (Optional) ==============
# If you want to enable email notifications

# SMTP Server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Email from address
# MAIL_FROM=noreply@umeed.org
