enum RsvpResponse {
  yes
  no
  maybe
}

model session_rsvps {
  id           String    @id @default(uuid())
  session_id   String
  volunteer_id String
  response     RsvpResponse?
  created_at   DateTime? @default(now())

  session      sessions   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  volunteer    volunteers @relation(fields: [volunteer_id], references: [id], onDelete: Cascade)
}
